{
  "name": "rest-api-tutorial-updated",
  "version": "1.0.0",
  "main": "index.js",
  "author": "Tom Nagle",
  "license": "MIT",
  "scripts": {
    "format": "npx prettier --write ./src",
    "start": "npm run build && cross-env NODE_ENV=development node dist/server.js",
    "start:dev": "cross-env NODE_ENV=development nodemon dist/server.js",
    "start:test": "cross-env NODE_ENV=test nodemon dist/server.js",
    "start:prod": "npm run build && npm run migrate:prod && cross-env NODE_ENV=production node dist/server.js",
    "build": "swc src -d dist --source-maps --copy-files && rsync -av dist/src/ dist/ && rm -rf dist/src",
    "build:dev": "swc src -d dist --source-maps --copy-files -w && mv dist/src/* dist/ && rm -rf dist/src",
    "run:dev": "cross-env NODE_ENV=development concurrently \"npm run build:dev\" \"npm run start:dev\"",
    "test": "jest --forceExit --detectOpenHandles",
    "test:dev": "cross-env NODE_ENV=test jest --watchAll --coverage --verbose --testTimeout=10000 --detectOpenHandles",
    "migrate:dev": "cross-env NODE_ENV=development npx sequelize-cli db:migrate",
    "migrate:dev:undo:last": "cross-env NODE_ENV=development npx sequelize-cli db:migrate:undo",
    "migrate:dev:undo": "cross-env NODE_ENV=development npx sequelize-cli db:migrate:undo:all",
    "migrate:test": "cross-env NODE_ENV=test npx sequelize-cli db:migrate",
    "migrate:test:undo": "cross-env NODE_ENV=test npx sequelize-cli db:migrate:undo:all",
    "seed:dev": "cross-env NODE_ENV=development npx sequelize-cli db:seed",
    "seed:dev:all": "cross-env NODE_ENV=development npx sequelize-cli db:seed:all",
    "seed:dev:undo": "cross-env NODE_ENV=development npx sequelize-cli db:seed:undo",
    "seed:dev:undo:all": "cross-env NODE_ENV=development npx sequelize-cli db:seed:undo:all",
    "seed:test": "cross-env NODE_ENV=test npx sequelize-cli db:seed:all",
    "seed:test:undo": "cross-env NODE_ENV=test npx sequelize-cli db:seed:undo:all",
    "migrate:prod": "cross-env NODE_ENV=production npx sequelize-cli db:migrate",
    "deploy:prod": "pm2 start ecosystem.config.js --env production --no-daemon",
    "deploy:dev": "pm2 start ecosystem.config.js --no-daemon",
    "debug": "nodemon --inspect=0.0.0.0:9229 --watch server server/bin/www",
    "migration:generate": "npx sequelize-cli migration:generate --name",
    "seed:generate": "npx sequelize-cli seed:generate --name",
    "seed:dev:undo:specific": "cross-env NODE_ENV=development npx sequelize-cli db:seed:undo --seed",
    "seed:dev:specific": "cross-env NODE_ENV=development npx sequelize-cli db:seed --seed",
    "seed:prod:undo:specific": "cross-env NODE_ENV=production npx sequelize-cli db:seed:undo --seed",
    "seed:prod:specific": "cross-env NODE_ENV=production npx sequelize-cli db:seed --seed"
  },
  "dependencies": {
    "@types/nodemailer": "^6.4.15",
    "aws-sdk": "^2.1692.0",
    "class-sanitizer": "^1.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "compression": "^1.7.4",
    "config": "^3.3.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^10.0.0",
    "envalid": "^8.1.0",
    "express": "^4.17.1",
    "fs-extra": "^11.3.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "http-status-codes": "^2.3.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "multer-s3": "^3.0.1",
    "mysql2": "^3.14.5",
    "nodemailer": "^6.9.14",
    "prettier": "^2.6.2",
    "sequelize": "^6.37.7",
    "tslib": "^2.8.1",
    "winston": "^3.7.2",
    "winston-daily-rotate-file": "^4.6.1"
  },
  "devDependencies": {
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.13.5",
    "@types/body-parser": "^1.19.1",
    "@types/compression": "^1.7.2",
    "@types/config": "^0.0.39",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/hpp": "^0.2.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/multer-s3": "^3.0.3",
    "@types/node": "^16.11.1",
    "nodemon": "^3.1.10",
    "sequelize-cli": "^6.6.3",
    "shx": "^0.4.0",
    "ts-node-dev": "^1.1.8",
    "typescript": "^4.4.4"
  }
}
